---
import '@fontsource/besley/400.css';
import '@fontsource/besley/400-italic.css';
import '@fontsource/besley/700.css';
import '@fontsource/besley/900.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '../../design-system/tokens.css';
import '../../design-system/components.css';
import '../styles/site.css';
import Seo from '../components/Seo.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; canonical?: string; ogImage?: string; type?: 'website' | 'article'; jsonLd?: object[]; bodyClass?: string; dataStatus?: string }
const { title, description, canonical = Astro.url.pathname, ogImage, type, jsonLd, bodyClass = '', dataStatus } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="day">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('cc-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'night' || q === 'day') t = q;
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    /* Cross-document view transitions: the title you click carries into the article headline, and back.
       Only one element may hold the name, so an article page (whose h1 already has it) never names a row. */
    (function () {
      var NAME = 'article-title';
      function titleFor(url) {
        var p = new URL(url, location.href).pathname, links = document.querySelectorAll('a.row, a.card');
        for (var i = 0; i < links.length; i++) if (new URL(links[i].href).pathname === p) return links[i].querySelector('.row-title, .card-title');
        return null;
      }
      function tag(vt, el) { if (!el || document.querySelector('.vt-title')) return; el.style.viewTransitionName = NAME; vt.finished.finally(function () { el.style.viewTransitionName = ''; }); }
      addEventListener('pageswap', function (e) { if (e.viewTransition && e.activation && e.activation.entry) tag(e.viewTransition, titleFor(e.activation.entry.url)); });
      addEventListener('pagereveal', function (e) {
        var from = window.navigation && navigation.activation && navigation.activation.from;
        if (e.viewTransition && from && from.url) tag(e.viewTransition, titleFor(from.url));
      });
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} jsonLd={jsonLd} />
</head>
<body class={bodyClass} data-status={dataStatus}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Masthead />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
