---
import { DESKS } from '../lib/desks';
interface Props { desk?: string; link?: boolean }
const { desk, link = true } = Astro.props;
---
{desk && link && <a class="cc-tag cc-tag-neutral" href={`/desk/${desk}/`}>{DESKS[desk].label}</a>}
{desk && !link && <span class="cc-tag cc-tag-neutral">{DESKS[desk].label}</span>}
