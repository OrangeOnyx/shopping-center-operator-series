---
import { DESK_IDS, DESKS } from '../lib/desks';
interface Props { active?: string }
const { active } = Astro.props;
---
<div class="tag-row desk-chips" aria-label="Desks">
  {DESK_IDS.map((id) => <a class={`cc-tag ${active === id ? 'cc-tag-accent' : 'cc-tag-neutral'}`} href={`/desk/${id}/`} aria-current={active === id ? 'page' : undefined}>{DESKS[id].label}</a>)}
</div>
