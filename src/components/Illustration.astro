---
import { illustration } from '../lib/illustrations';
interface Props { name: string; class?: string; decorative?: boolean; animate?: boolean }
const { name, class: cls = '', decorative = false, animate = false } = Astro.props;
const il = illustration(name);
---
{il && (
  <svg class={`illo ${il.cls ?? ''} ${cls}`} viewBox={il.viewBox ?? '0 0 840 300'} preserveAspectRatio="xMidYMid meet"
    role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : il.label} aria-hidden={decorative ? 'true' : undefined}
    set:html={il.svg} />
)}
{il && animate && (
  <script is:inline>
    /* Brand motion: draw once per load, only if the drawing is already on screen. Runs during parse, before
       first paint, so nothing flashes and nothing waits invisibly for a scroll. */
    (function (s) {
      var el = s.previousElementSibling;
      try {
        if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var r = el.getBoundingClientRect();
        if (r.top < innerHeight && r.bottom > 0) el.classList.add('is-drawing');
      } catch (e) {}
    })(document.currentScript);
  </script>
)}
