---
import StateTag from './StateTag.astro';
import Illustration from './Illustration.astro';
import { illustrationFor } from '../lib/illustrations';
import type { CollectionEntry } from 'astro:content';
interface Props { series: CollectionEntry<'series'>; count: number }
const { series, count } = Astro.props;
const s = series.data;
const illo = illustrationFor({ collection: s.slug });
const ink = ['terra', 'olive', 'mustard', 'muscadine'][(s.order - 1) % 4];
---
<a class={`cc-card cc-card-accent collection-card cc-card-interactive ink-${ink}`} href={`/${s.slug}/`}>
  <div class="inkblock card-inkhead">
    <span class="card-inkhead-num">{String(s.order).padStart(2, '0')}</span>
    <span class="card-inkhead-kind">{s.kind === 'lane' ? 'Lane' : 'Series'}</span>
  </div>
  {illo && <div class="card-illo"><Illustration name={illo} decorative /></div>}
  <span class="tag-row card-state"><StateTag state={s.state} /></span>
  <span class="card-title">{s.title}</span>
  <span class="card-deck">{s.deck}</span>
  <span class="meta">
    {s.state === 'published'
      ? `${count} ${s.kind === 'lane' ? (count === 1 ? 'note' : 'notes') : (count === 1 ? 'article' : 'articles')}`
      : s.plannedTitles.length ? `${s.plannedTitles.length} titles planned` : 'Coming soon'}
  </span>
</a>
